tmp/
temp/

# ---- Private data: never commit ----
# Local databases (SwiftData / SQLite stores)
*.store
*.store-shm
*.store-wal
*.sqlite
*.sqlite-shm
*.sqlite-wal
*.db
# App exports and backups
*.mmbackup
exports/
# Diagnostic reports from a phone
TallySeam-Diagnostics-*
application-logs.jsonl
crash-reports.json
performance-metrics.json
# Screenshots and real receipts (synthetic test fixtures belong in TallySeam/Tests/Fixtures)
screenshots/
Screenshots/
receipts/
*.png
*.jpg
*.jpeg
*.heic
*.HEIC
!docs/images/**
!TallySeam/Resources/**
!TallySeam/Tests/Fixtures/**
# Signing, keys and credentials
*.p12
*.p8
*.pem
*.key
*.cer
*.mobileprovision
*.provisionprofile
.env
.env.*
secrets/
fastlane/report.xml

# Python
__pycache__/
*.pyc
jobs.json

